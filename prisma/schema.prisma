generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AmendmentAction {
  ADD
  MODIFY
  STRIKE
}

enum ScoreType {
  POI
  SPEECH
  AMENDMENT
  RESOLUTION
}

enum AttendanceStatus {
  PRESENT
  PRESENT_AND_VOTING
  ABSENT
}

model Committee {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  /// One agenda topic per line
  topics    String   @default("")
  sortOrder Int      @default(0)
  /// Access code chairs of this committee enter to open their portal. Set by the secretariat.
  chairCode String?  @unique
  createdAt DateTime @default(now())

  issues             Issue[]
  crisisUpdates      CrisisUpdate[]
  delegations        Delegation[]
  resolutions        Resolution[]
  amendments         Amendment[]
  scoreEvents        ScoreEvent[]
  attendanceSessions AttendanceSession[]
  scheduleItems      ScheduleItem[]
  reports            ChairReport[]
}

model Delegation {
  id          String    @id @default(cuid())
  name        String
  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  resolutions Resolution[]
  amendments  Amendment[]
  scoreEvents ScoreEvent[]
  attendance  AttendanceRecord[]
  issues      Issue[]

  @@unique([committeeId, name])
}

model Resolution {
  id               String       @id @default(cuid())
  /// Short public number within the committee, e.g. 3 -> "HRC/R/3"
  number           Int
  /// Private code given to the submitter so they can track status
  trackingCode     String       @unique
  committeeId      String
  committee        Committee    @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  delegationId     String
  delegation       Delegation   @relation(fields: [delegationId], references: [id], onDelete: Cascade)
  coSubmitters     String       @default("")
  topic            String       @default("")
  preambulatory    String
  operative        String
  status           ReviewStatus @default(PENDING)
  chairNote        String       @default("")
  chosen           Boolean      @default(false)
  chosenAt         DateTime?
  reviewedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  amendments  Amendment[]
  scoreEvents ScoreEvent[]

  @@unique([committeeId, number])
  @@index([committeeId, status])
}

model Amendment {
  id           String          @id @default(cuid())
  number       Int
  trackingCode String          @unique
  committeeId  String
  committee    Committee       @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  delegationId String
  delegation   Delegation      @relation(fields: [delegationId], references: [id], onDelete: Cascade)
  resolutionId String?
  resolution   Resolution?     @relation(fields: [resolutionId], references: [id], onDelete: SetNull)
  /// Free-text resolution reference when not linked (e.g. a draft not yet on the system)
  resolutionRef String         @default("")
  clause       String
  action       AmendmentAction
  text         String          @default("")
  rationale    String          @default("")
  status       ReviewStatus    @default(PENDING)
  chairNote    String          @default("")
  chosen       Boolean         @default(false)
  chosenAt     DateTime?
  reviewedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  scoreEvents ScoreEvent[]

  @@unique([committeeId, number])
  @@index([committeeId, status])
}

model ScoreEvent {
  id           String      @id @default(cuid())
  committeeId  String
  committee    Committee   @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  delegationId String
  delegation   Delegation  @relation(fields: [delegationId], references: [id], onDelete: Cascade)
  type         ScoreType
  points       Int
  note         String      @default("")
  amendmentId  String?     @unique
  amendment    Amendment?  @relation(fields: [amendmentId], references: [id], onDelete: Cascade)
  resolutionId String?     @unique
  resolution   Resolution? @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@index([committeeId, createdAt])
}

model AttendanceSession {
  id          String    @id @default(cuid())
  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime  @default(now())

  records AttendanceRecord[]
}

model AttendanceRecord {
  id           String            @id @default(cuid())
  sessionId    String
  session      AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  delegationId String
  delegation   Delegation        @relation(fields: [delegationId], references: [id], onDelete: Cascade)
  status       AttendanceStatus
  updatedAt    DateTime          @updatedAt

  @@unique([sessionId, delegationId])
}

model ScheduleItem {
  id          String     @id @default(cuid())
  title       String
  description String     @default("")
  location    String     @default("")
  startsAt    DateTime
  endsAt      DateTime?
  /// null = applies to everyone
  committeeId String?
  committee   Committee? @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@index([startsAt])
}

model ChairReport {
  id           String    @id @default(cuid())
  committeeId  String
  committee    Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  title        String
  fileName     String
  mimeType     String
  size         Int
  data         Bytes
  /// "GA chair" or "Secretariat"
  uploadedBy   String    @default("")
  createdAt    DateTime  @default(now())
}

model AppSetting {
  key   String @id
  value String
}

enum IssueKind {
  STRIKE
  EQUIPMENT
  OTHER
}

enum IssueStatus {
  OPEN
  RESOLVED
}

/// Problems the secretariat needs to see: strikes given to delegations, missing equipment, anything else.
model Issue {
  id           String      @id @default(cuid())
  kind         IssueKind
  status       IssueStatus @default(OPEN)
  /// null = raised by the secretariat for the whole conference
  committeeId  String?
  committee    Committee?  @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  /// Required for strikes: the delegation that received it
  delegationId String?
  delegation   Delegation? @relation(fields: [delegationId], references: [id], onDelete: Cascade)
  details      String
  reportedBy   String      @default("")
  resolution   String      @default("")
  createdAt    DateTime    @default(now())
  resolvedAt   DateTime?

  @@index([status, createdAt])
  @@index([committeeId])
}

/// Urgent notice from the secretariat, shown at the top of every committee's pages.
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Crisis news for one committee (e.g. SC, ICJ). Hidden from delegates until publishAt.
model CrisisUpdate {
  id          String    @id @default(cuid())
  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  title       String
  body        String
  publishAt   DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([committeeId, publishAt])
}
